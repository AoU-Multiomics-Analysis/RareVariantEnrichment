FROM mambaorg/micromamba:2.10.0@sha256:e1476182cd40eb1f7c0cfae4adec9bfd78f3d7f05c61368306abfdc8939c1198

LABEL org.opencontainers.image.source="https://github.com/aou-multiomics-analysis/RareVariantEnrichment" \
      org.opencontainers.image.description="Olink PC adjustment and outlier detection for Terra"

COPY --chown=$MAMBA_USER:$MAMBA_USER envs/olink-environment.yml /opt/olink/environment.yml
RUN micromamba install --yes --name base --strict-channel-priority \
        --file /opt/olink/environment.yml \
    && micromamba clean --all --yes

COPY --chown=$MAMBA_USER:$MAMBA_USER scripts/olink_outliers.R /opt/olink/olink_outliers.R

# Cromwell can replace the entrypoint. Keep Rscript on PATH in that case.
ENV PATH="/opt/conda/bin:${PATH}" \
    OLINK_SCRIPT="/opt/olink/olink_outliers.R"

USER root
RUN chmod 0755 /opt/olink \
    && chmod 0644 /opt/olink/olink_outliers.R /opt/olink/environment.yml \
    && mkdir -p /work \
    && chmod 1777 /work
USER $MAMBA_USER
WORKDIR /work

# Keep shell commands usable by Terra/Cromwell; do not bind the entrypoint to R.
ENTRYPOINT ["/usr/local/bin/_entrypoint.sh"]
CMD ["bash"]
